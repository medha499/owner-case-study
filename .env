# ─── REQUIRED for LLM synthesis ───
ANTHROPIC_API_KEY="##REPLACE_WITH_YOUR_ANTHROPIC_API_KEY#"

# ─── REQUIRED for live competitor watch + account intel ───
TAVILY_API_KEY="##REPLACE_WITH_YOUR_TAVILY_API_KEY#"

# ─── CSV paths (defaults to data/csv/)  make sure to add the files and create folder ───
CSV_CALLS_PATH="data/csv/calls.csv"
CSV_RESTAURANTS_PATH="data/csv/restaurants.csv"

# Optional: chunk size for parallel extraction
EXTRACT_CHUNK_SIZE=25
EXTRACT_MAX_WORKERS=15

# Auto-refresh pipeline in background. 0 = disabled, otherwise seconds (e.g. 1800 = every 30min)
AUTO_REFRESH_SECONDS=0
PORT=8000


## OPTIONAL - NOT IMPLEMENTED ELEVENLABS CONFIG (for TTS of agent responses, not required for LLM synthesis)

ELEVENLABS_API_KEY="##REPLACE_WITH_YOUR_ELEVENLABS_API_KEY#"
ELEVENLABS_VOICE_ID="##REPLACE_WITH_YOUR_ELEVENLABS_VOICE_ID#"

